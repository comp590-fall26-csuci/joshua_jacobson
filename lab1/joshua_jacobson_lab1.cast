[1816.322765, "o", "\u001b[1;1H\u001b[35mimport\u001b[m sys\u001b[2;1H\u001b[K\u001b[3;1H\u001b[38;5;130mdef\u001b[m \u001b[36mfib\u001b[m(x, file):\u001b[3;18H\u001b[K\u001b[4;5H\u001b[38;5;130mif\u001b[m x == \u001b[31m0\u001b[m:\u001b[5;9H\u001b[38;5;130mreturn\u001b[m \u001b[31m0\u001b[m\r\n    \u001b[38;5;130mif\u001b[m x == \u001b[31m1\u001b[m:\u001b[7;9H\u001b[34m# This is kind of a hack to get the first two values.\u001b[8;9H# we won't ever get into the x = 0 case where file\u001b[9;9H# will not be None, but since we get into this case only\u001b[10;9H# once as the very first time we are attempting to write,\u001b[11;9H# we can use that as the time to print both the first\u001b[12;9H# and second values of the sequence.\u001b[m\u001b[13;9H\u001b[38;5;130mif\u001b[m file \u001b[38;5;130mis\u001b[m \u001b[38;5;130mnot\u001b[m \u001b[36mNone\u001b[m:\u001b[14;13Hfile.write(\u001b[31m\"0\u001b[m\u001b[35m\\n\u001b[m\u001b[31m1\u001b[m\u001b[35m\\n\u001b[m\u001b[31m\"\u001b[m)\u001b[15;9H\u001b[38;5;130mreturn\u001b[m \u001b[31m1\u001b[m\r\n    value = fib(x-\u001b[31m1\u001b[m, file) + fib(x-\u001b[31m2\u001b[m, \u001b[36mNone\u001b[m)\r\n    \u001b[38;5;130mif\u001b[m file \u001b[38;5;130mis\u001b[m \u001b[38;5;130mnot\u001b[m \u001b[36mNone\u001b[m:\u001b[18;9Hfile.write(f\u001b[31m\"{value}\u001b[m\u001b[35m\\n\u001b[m\u001b[31m\"\u001b[m)\r\n    \u001b[38;5;130mreturn\u001b[m value\r\n\r\n\u001b[38;5;130mif\u001b[m __name__ == \u001b[31m'__main__'\u001b[m:\r\n    \u001b[38;5;130mwith\u001b[m \u001b[36mopen\u001b[m(\u001b[31m\"output/output.txt\"\u001b[m, \u001b[31m\"w\"\u001b[m) \u001b[38;5;130mas\u001b[m output:\u001b[23;9Hfib(\u001b[31m24\u001b[m, output)\u001b[24;63H12,44\u001b[9CAll\u001b[12;44H\u001b[?25h"]
[1816.329035, "o", "\u001bP+q436f\u001b\\\u001bP+q6b75\u001b\\\u001bP+q6b64\u001b\\\u001bP+q6b72\u001b\\\u001bP+q6b6c\u001b\\\u001bP+q2332\u001b\\\u001bP+q2334\u001b\\\u001bP+q2569\u001b\\\u001bP+q2a37\u001b\\\u001bP+q6b31\u001b\\\u001bP$q q\u001b\\\u001b[?12$p\u001b[?25l\u001b[24;53H:\u001b[12;44H\u001b[24;54H3\u001b[12;44H\u001b[24;55H0\u001b[12;44H\u001b[24;56H3\u001b[12;44H\u001b[24;57H0\u001b[12;44H\u001b[24;58H/\u001b[12;44H\u001b[24;59H0\u001b[12;44H\u001b[24;60Ha\u001b[12;44H\u001b[24;61H0\u001b[12;44H\u001b[24;62Ha\u001b[12;44H"]
[1816.332943, "o", "\u001b[24;53H          \u001b[12;44H\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[1;1H\u001b[38;5;81mimport\u001b[m sys\r\n\r\n\u001b[93mdef\u001b[m \u001b[1m\u001b[96mfib\u001b[m(x, file):\r\n    \u001b[93mif\u001b[m x == \u001b[95m0\u001b[m:\u001b[5;9H\u001b[93mreturn\u001b[m \u001b[95m0\u001b[m\r\n    \u001b[93mif\u001b[m x == \u001b[95m1\u001b[m:\u001b[7;9H\u001b[96m# This is kind of a hack to get the first two values.\u001b[8;9H# we won't ever get into the x = 0 case where file\u001b[9;9H# will not be None, but since we get into this case only\u001b[10;9H# once as the very first time we are attempting to write,\u001b[11;9H# we can use that as the time to print both the first\u001b[12;9H# and second values of the sequence.\u001b[m\u001b[13;9H\u001b[93mif\u001b[m file \u001b[93mis\u001b[m \u001b[93mnot\u001b[m \u001b[1m\u001b[96mNone\u001b[m:\u001b[14;13Hfile.write(\u001b[95m\"0\u001b[m\u001b[38;5;224m\\n\u001b[m\u001b[95m1\u001b[m\u001b[38;5;224m\\n\u001b[m\u001b[95m\"\u001b[m)\u001b[15;9H\u001b[93mreturn\u001b[m \u001b[95m1\u001b[m\r\n    value = fib(x-\u001b[95m1\u001b[m, file) + fib(x-\u001b[95m2\u001b[m, \u001b[1m\u001b[96mNone\u001b[m)\r\n    \u001b[93mif\u001b[m file \u001b[93mis\u001b[m \u001b[93mnot\u001b[m \u001b[1m\u001b[96mNone\u001b[m:\u001b[18;9Hfile.write(f\u001b[95m\"{value}\u001b[m\u001b[38;5;224m\\n\u001b[m\u001b[95m\"\u001b[m)\r\n    \u001b[93mreturn\u001b[m value\r\n\r\n\u001b[93mif\u001b[m __name__ == \u001b[95m'__main__'\u001b[m:\r\n    \u001b[93mwith\u001b[m \u001b[1m\u001b[96mopen\u001b[m(\u001b[95m\"output/output.txt\"\u001b[m, \u001b[95m\"w\"\u001b[m) \u001b[93mas\u001b[m output:\u001b[23;9Hfib(\u001b[95m24\u001b[m, output)\u001b[24;63H12,44\u001b[9CAll\r\"lab1.py\" 23L, 737B\u001b[12;44H\u001b[?25h"]
