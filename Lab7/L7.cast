[19179.887769, "o", "\u001b[1;3H\u001b[36mpull_request\u001b[m\u001b[35m:\u001b[m\r\n    \u001b[36mbranches\u001b[m\u001b[35m:\u001b[m \u001b[35m[\u001b[m \u001b[31m\"main\"\u001b[m \u001b[35m]\u001b[m\u001b[2;25H\u001b[K\u001b[3;1H\u001b[K\u001b[4;1H\u001b[36mjobs\u001b[m\u001b[35m:\u001b[m\r\n  \u001b[36mbuild\u001b[m\u001b[35m:\u001b[m\u001b[7;5H\u001b[36mruns-on\u001b[m\u001b[35m:\u001b[m ubuntu-latest\u001b[9;5H\u001b[36msteps\u001b[m\u001b[35m:\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36muses\u001b[m\u001b[35m:\u001b[m actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683\u001b[34m # v4.2.2\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m make\u001b[12;7H\u001b[36mworking-directory\u001b[m\u001b[35m:\u001b[m ./lab4\u001b[13;7H\u001b[36mrun\u001b[m\u001b[35m:\u001b[m make main\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m test\u001b[15;7H\u001b[36mworking-directory\u001b[m\u001b[35m:\u001b[m ./scripts\u001b[16;7H\u001b[36mrun\u001b[m\u001b[35m:\u001b[m bash ./fibTest.sh\r\n  \u001b[36msemgrep\u001b[m\u001b[35m:\u001b[m\r\n    \u001b[36mruns-on\u001b[m\u001b[35m:\u001b[m ubuntu-latest\r\n    \u001b[36mcontainer\u001b[m\u001b[35m:\u001b[m\u001b[20;7H\u001b[36mimage\u001b[m\u001b[35m:\u001b[m semgrep/semgrep\r\n    \u001b[36msteps\u001b[m\u001b[35m:\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36muses\u001b[m\u001b[35m:\u001b[m actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683\u001b[34m # v4.2.2\u001b[m\r\n    \u001b[38;5;130m-\u001b[m \u001b[36mname\u001b[m\u001b[35m:\u001b[m Run Semgrep Scan\u001b[24;7H\u001b[36mrun\u001b[m\u001b[35m:\u001b[m semgrep scan --config p/default --error\u001b[25;63H29,7\u001b[10CBot\u001b[24;7H\u001b[?25h\u001b[?4m"]
